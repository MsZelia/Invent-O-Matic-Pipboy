{
	"debug": false,
	"debugKeys": false,
	"toggleDebugHotkey": 192,
	"hideLoadMessage": false,
	"disableScrollWrap": false,
	"delayTabSwitching": 250,
	"delayCloseMenu": 500,
	
	"orderButtons": ["findForRepair", "itemLocking", "consume", "drop"],
	
	"itemNamesGroupConfig": {
		"TEST_GROUP": ["item 1", "item 2", "item 3..."]
	},
	"protectionConfig": {
		"debug": false,
		"checkOnSelectionChange": true,
		"itemLocking": {
			"enabled": true,
			"debug": true,
			"showButton": true,
			"showMessage": true,
			"name": "Lock All",
			"hotkey": "K",
			"delay": 50,
			"types": ["WEAPON", "ARMOR", "APPAREL", "FOOD_WATER", "AID", "JUNK"]
		},
		"dropProtection": {
			"enabled": true,
			"favorite": true,
			"equipped": true,
			"unique": false,
			"named": false,
			"matchMode": "CONTAINS",
			"itemNames": ["unyielding", "overeater", "item 3"]
		},
		"equipProtection": {
			"enabled": false,
			"apparel": false,
			"parts": ["UNDERARMOR", "HAT"]
		}
	},
	"findForRepair": {
		"enabled": false,
		"name": "Fnd4Rep",
		"showButton": true,
		"showMessage": false,
		"hotkey": "J",
		"types": ["WEAPON", "ARMOR"],
		"onlyIfEquipped": true,
		"onlyIfFavorite": true,
		"conditionUnder": 10,
		"repeatAfter": 0 // use 1000 if you have auto-repair set up
	},
	"drop": {
		"enabled": false,
		"configs": [
			{
				"enabled": false,
				"name": "Drop example: Different possible/optional parameters",
				"showButton": true,
				"showMessage": false,
				"closeMenu": false,
				"hotkey": "P",
				"amount": 0,
				"matchMode": "EXACT",
				"itemNames": ["Item name 1", "Item name 2"],
				"types": ["POWER_ARMOR","WEAPON","ARMOR","APPAREL","FOOD_WATER","AID","NOTES","HOLO","AMMO","MISC","MODS","JUNK"],
				"dropFavorite": false,
				"dropEquipped": false,
				"checkCharacterName": false,
				"characterName": "none",
				"checkAccountName": false,
				"accountName": "none",
				"teenoodleTragedyProtection": {
					"ignoreLegendaries": false,
					"ignoreNonTradable": false,
					"ignoreUniques": false,
					"excluded": ["item 3", "item 4", "..."]
				}
			},
			{
				"enabled": false,
				"name": "Drop Example: All Unused ammo, no cores",
				"showButton": true,
				"showMessage": false,
				"closeMenu": false,
				"hotkey": "F5",
				"matchMode": "ALL",
				"itemNames": [""],
				"types": ["AMMO"],
				"teenoodleTragedyProtection": {
					"excluded": ["core"]
				}
			},
			{
				"enabled": false,
				"name": "Drop Example: Heavy ammo",
				"showButton": true,
				"showMessage": false,
				"closeMenu": false,
				"hotkey": "F5",
				"matchMode": "CONTAINS",
				"itemNames": ["mini nuke", "missile", "cannonball", "40mm", "harpoon"],
				"types": ["AMMO"]
			},
			{
				"enabled": false,
				"name": "Drop Example: All junk with exclusions",
				"showButton": false,
				"closeMenu": false,
				"hotkey": "F6",
				"matchMode": "ALL",
				"itemNames": ["-"],
				"types": ["JUNK"],
				"teenoodleTragedyProtection": {
					"excluded": ["spring", "ballistic fiber", "oil"]
				}
			},
			{
				// Subconfigs let you combine multiple drop configs that you want mapped to the same hotkey into a
				// slightly less verbose config.
				// Subconfigs cannot be used with "itemNames" at the parent drop config level.
				// Subconfigs can have all the fields of a normal drop config. However, the following are different:
				// - enabled: If not given, uses parent config's value.
				// - showButton: Ignored. Parent config button + name are used instead.
				// - showMessage: Ignored. Parent config message is used instead.
				// - closeMenu: Ignored. If parent config sets to true, the last subconfig will close the menu.
				// - name: If not given, autogenerated based of parent config name.
				"enabled": false,
				"name": "Drop Example: Subconfigs",
				"showButton": false,
				"closeMenu": false,
				"hotkey": "F7",
				"subconfigs": [
					{
						"name": "Heavy Ammo",
						"matchMode": "CONTAINS",
						"types": ["AMMO"],
						"itemNames": ["mini nuke", "missile"]
					},
					{
						"name": "Most Junk",
						"matchMode": "ALL",
						"types": ["JUNK"],
						"itemNames": [""],
						"teenoodleTragedyProtection": {
							"excluded": ["spring", "oil"]
						}
					}
				]
			}
		]
	},
